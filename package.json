{
  "name": "customer-onboarding",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "dev": "tsx scripts/environment.ts dev",
    "verify": "tsx scripts/environment.ts verify",
    "env:doctor": "tsx scripts/environment.ts doctor",
    "env:status": "tsx scripts/environment.ts status",
    "env:clean": "tsx scripts/environment.ts clean",
    "demo:reset": "tsx scripts/environment.ts reset",
    "browser:install": "tsx scripts/install-browser.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 apps/api/test/*.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "build": "pnpm --filter @onboarding/web build && tsc -p apps/api/tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "arktype": "2.2.8",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
